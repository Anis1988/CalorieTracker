# Copy to .env.local for `npm run dev` (never commit real keys). On Vercel: Settings → Environment Variables.
APP_ACCESS_TOKEN=pick-a-long-secret-code
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Recipe photos (free): Pexels, else Pixabay, else Wikimedia Commons (no key)
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Upstash Redis (Vercel → Storage → Upstash for Redis adds these by itself)
KV_REST_API_URL=
KV_REST_API_TOKEN=
